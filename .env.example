# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# SESSION_SECRET: long random secret used to sign HttpOnly login cookies.
# REQUIRED in production. Generate a unique high-entropy value and store it in Secret Manager.
SESSION_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_SECRET"

# ADMIN_PASSWORD: administrator login password.
# REQUIRED for the seeded SOLNEXA administrator account. Never commit the real password.
ADMIN_PASSWORD="CHANGE_ME_TO_A_STRONG_ADMIN_PASSWORD"

# PORTAL_DEMO_PASSWORD: optional password for seeded non-admin demo accounts.
# Leave unset in production if demo accounts should not be usable.
PORTAL_DEMO_PASSWORD=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
